# Copy to .env and fill in. .env is gitignored — never commit it. SETUP.md
# walks through every line.

# --- Cloudflare (read by wrangler and `npm run setup`; never pushed to a Worker)
# An account-scoped token: "Edit Cloudflare Workers" template plus D1: Edit,
# Access: Apps and Policies: Edit, and Access: Organizations…: Read.
CLOUDFLARE_API_TOKEN=
CLOUDFLARE_ACCOUNT_ID=

# Who may sign in to the app: the email you use for Cloudflare.
OWNER_EMAIL=
# For the morning digest and reminders, e.g. America/Los_Angeles. Blank = this
# computer's time zone.
TIMEZONE=

# --- Pocket ------------------------------------------------------------------
# Pocket app → Settings → API key.
POCKET_API_KEY=
# Optional. Shown once when you create a webhook in the Pocket app.
POCKET_WEBHOOK_SECRET=

# --- Anthropic (the planner) ---------------------------------------------------
ANTHROPIC_API_KEY=

# --- Telegram ------------------------------------------------------------------
# From @BotFather (/newbot). Message your bot once, then `npm run
# telegram:setup` fills in the other two.
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
TELEGRAM_WEBHOOK_SECRET=

# --- Written by `npm run setup` --------------------------------------------------
# Your Cloudflare ids. `npm run config` (every deploy runs it) fills them into
# wrangler.jsonc and wrangler.app.jsonc.
KV_ID=
D1_ID=
ACCESS_TEAM_DOMAIN=
ACCESS_AUD=
APP_URL=
WORKER_URL=
